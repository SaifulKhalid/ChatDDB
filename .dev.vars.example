# ChatDDB — local Worker secrets
#
# 1. Copy this file to `.dev.vars` (same directory). `.dev.vars` is gitignored.
# 2. Paste your API provider key(s) below.
# 3. Run `npm run dev:all`.
#
# For the deployed Worker, set them as real secrets instead:
#   npx wrangler secret put AGENTROUTER_API_KEY
#   npx wrangler secret put AGENTROUTER_API_KEY_2
#   npx wrangler secret put AGENTROUTER_API_KEY_3

AGENTROUTER_API_KEY=sk-replace-me
# AGENTROUTER_API_KEY_2=sk-replace-me
# AGENTROUTER_API_KEY_3=sk-replace-me

# The ApiNex API text provider key (serves gpt-6.1-sol, free/gpt-6-luna).
# Deployed:  npx wrangler secret put APINEX_API_KEY
APINEX_API_KEY=sk-apx-replace-me
# APINEX_API_KEY_2=sk-apx-replace-me
# APINEX_API_KEY_3=sk-apx-replace-me

# The backup image provider (optional). With this set, an exhausted Workers AI
# allowance stops being visible: Pollinations draws the image instead.
# Deployed:  npm run secret:pollinations
# POLLINATIONS_API_KEY=pk-replace-me

# Optional overrides — defaults live in the dynamic AI service/provider/route
# records created by migrations/0007_ai_services_and_routing.sql.
# POLLINATIONS_MODEL=flux
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai
# POLLINATIONS_ENABLED=true
# RATE_TOOL_IMAGE_PER_DAY=5
