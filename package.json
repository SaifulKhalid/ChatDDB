{
  "name": "prototype-chatbot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute prototype-chatbot-db --local --file=src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute prototype-chatbot-db --remote --file=src/db/schema.sql",
    "db:reset": "wrangler d1 execute prototype-chatbot-db --local --command=\"DROP TABLE IF EXISTS messages; DROP TABLE IF EXISTS conversations;\" && npm run db:init",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "unpdf": "^0.12.1"
  }
}