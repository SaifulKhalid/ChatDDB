{
  "name": "chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:all": "concurrently -n vite,worker -c cyan,magenta \"npm:dev\" \"npm:dev:worker\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "secret": "wrangler secret put PROVIDER_API_KEY",
    "secret:pollinations": "wrangler secret put POLLINATIONS_API_KEY",
    "secret:files": "wrangler secret put FILE_URL_SECRET",
    "secret:salt": "wrangler secret put IP_HASH_SALT",
    "db:migrate:local": "wrangler d1 migrations apply chatddb-f5-db --local",
    "db:migrate": "wrangler d1 migrations apply chatddb-f5-db --remote",
    "db:tables": "wrangler d1 execute chatddb-f5-db --local --command \"select name from sqlite_master where type='table' order by name\"",
    "probe:vision": "node scripts/probe-vision.mjs",
    "probe:tools": "node scripts/probe-tool-calling.mjs",
    "probe:openrouter": "node scripts/probe-openrouter.mjs",
    "test:failover": "node --experimental-strip-types scripts/test-failover.mjs",
    "stub:gateway": "node scripts/stub-gateway.mjs",
    "smoke:failover": "node scripts/smoke-failover.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:files": "node scripts/smoke-files.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:images": "node scripts/smoke-images.mjs",
    "smoke:image-failover": "node scripts/smoke-image-failover.mjs",
    "smoke:chat-image-tool": "node scripts/smoke-chat-image-tool.mjs",
    "stub:pollinations": "node scripts/stub-pollinations.mjs",
    "db:prune": "node scripts/prune.mjs",
    "cf-typegen": "wrangler types",
    "smoke:svg-sanitizer": "node scripts/smoke-svg-sanitizer.mjs",
    "smoke:figure-gate": "node scripts/smoke-figure-gate.mjs",
    "smoke:tool-peek": "node --experimental-strip-types scripts/smoke-tool-peek.mjs",
    "smoke:sse-null": "node --experimental-strip-types scripts/smoke-sse-null-frame.mjs",
    "probe:svg": "node scripts/probe-svg-diagrams.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dompurify": "^3.4.12",
    "firebase": "^12.16.0",
    "highlight.js": "^11.11.1",
    "jose": "^6.2.4",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.115.0"
  }
}
